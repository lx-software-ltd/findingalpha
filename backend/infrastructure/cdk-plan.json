{
  "groups": [
    {
      "stacks": ["findingalpha", "findingalpha-admin-web"],
      "prefixes": ["findingalpha:", "findingalpha-admin-web:"],
      "extra-args": [
        "--parameters",
        "findingalpha:AdminWebDomainName={P_ADMIN_DOMAIN}",
        "--parameters",
        "findingalpha:GoogleClientId={P_GOOGLE_CLIENT_ID}",
        "--parameters",
        "findingalpha:GoogleClientSecret={P_GOOGLE_CLIENT_SECRET}",
        "--parameters",
        "findingalpha:AdminFederatedEmailAllowlist={P_EMAIL_ALLOWLIST}",
        "--parameters",
        "findingalpha:MailSendingDomain={P_MAIL_DOMAIN}",
        "--parameters",
        "findingalpha:BriefRecipientEmail={P_BRIEF_RECIPIENT}",
        "--parameters",
        "findingalpha:SecContactEmail={P_SEC_CONTACT}",
        "--parameters",
        "findingalpha-admin-web:AdminWebDomainName={P_ADMIN_DOMAIN}",
        "--parameters",
        "findingalpha:ApiCustomDomainName={P_API_DOMAIN}",
        "--parameters",
        "findingalpha:ApiCustomDomainCertificateArn={P_API_CERT}",
        "--parameters",
        "findingalpha:CognitoCustomDomainName={P_COGNITO_DOMAIN}",
        "--parameters",
        "findingalpha:CognitoCustomDomainCertificateArn={P_COGNITO_CERT}",
        "--parameters",
        "findingalpha-admin-web:AdminWebCertificateArn={P_CERT_ARN}",
        "--parameters",
        "findingalpha-admin-web:CspCognitoConnectOrigin={P_CSP_ORIGIN}",
        "--parameters",
        "findingalpha-admin-web:WafWebAclArn={P_WAF_ARN}"
      ]
    },
    {
      "stacks": ["findingalpha-public-www"],
      "prefixes": ["findingalpha-public-www:"],
      "when-all-env": ["P_PUBLIC_DOMAIN", "P_PUBLIC_CERT_ARN"],
      "extra-args": [
        "--parameters",
        "findingalpha-public-www:PublicWebsiteDomainName={P_PUBLIC_DOMAIN}",
        "--parameters",
        "findingalpha-public-www:PublicWebsiteCertificateArn={P_PUBLIC_CERT_ARN}",
        "--parameters",
        "findingalpha-public-www:WafWebAclArn={P_PUBLIC_WAF_ARN}"
      ]
    }
  ]
}
